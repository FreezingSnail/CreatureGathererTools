{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CreatureGathererFX",
  "version": "0.1.0",
  "identifier": "com.freezingsnail.creaturegathererfx",
  "build": {
    "beforeDevCommand": "npm --prefix /Users/connorfranc/code/CreatureGathererTools/ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix /Users/connorfranc/code/CreatureGathererTools/ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CreatureGathererFX",
        "width": 1280,
        "height": 832
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}